<!-- Operational state only. No active response or intrusion attribution. -->
<group name="home_monitoring,operations,">
  <rule id="100600" level="3">
    <decoded_as>home_monitoring</decoded_as>
    <field name="home_monitoring.scope">^operations$</field>
    <description>Home monitoring: $(home_monitoring.event_type) $(home_monitoring.status)</description>
  </rule>
  <rule id="100601" level="5">
    <if_sid>100600</if_sid>
    <field name="home_monitoring.event_type">^alert_transition$</field>
    <field name="home_monitoring.status">^firing$</field>
    <description>Operational alert firing: $(home_monitoring.alertname) on $(home_monitoring.instance)</description>
  </rule>
  <rule id="100602" level="9">
    <if_sid>100601</if_sid>
    <field name="home_monitoring.severity">^critical$</field>
    <description>Critical operational alert: $(home_monitoring.alertname) on $(home_monitoring.instance)</description>
  </rule>
  <rule id="100603" level="3">
    <if_sid>100600</if_sid>
    <field name="home_monitoring.event_type">^alert_transition$</field>
    <field name="home_monitoring.status">^resolved$</field>
    <description>Operational alert no longer firing in Prometheus: $(home_monitoring.alertname)</description>
  </rule>
  <rule id="100604" level="7">
    <if_sid>100600</if_sid>
    <field name="home_monitoring.event_type">^collector_health$</field>
    <field name="home_monitoring.status">^unavailable$</field>
    <description>Home monitoring collector cannot obtain a complete Prometheus snapshot; existing alerts remain open</description>
  </rule>
  <rule id="100605" level="3">
    <if_sid>100600</if_sid>
    <field name="home_monitoring.event_type">^collector_health$</field>
    <field name="home_monitoring.status">^recovered$</field>
    <description>Home monitoring collector recovered its Prometheus connection</description>
  </rule>
</group>
