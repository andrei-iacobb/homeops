<!--
  TPIC demo rules (homeops Wazuh demo). SYNTHETIC DATA ONLY.

  These rules classify hand-injected, simulated "outbound transfer" events so
  the same byte count can be shown as benign (approved backup) or suspicious
  (unapproved destination). They only ever see events that carry
  tpic_demo.synthetic=true, and an alert from them says nothing about real
  traffic: it cannot be read as evidence of actual data exfiltration.
  Detection only - no active response is attached to any of these rules.
-->
<group name="tpic_demo,synthetic,">

  <rule id="100500" level="3">
    <decoded_as>tpic_demo</decoded_as>
    <field name="tpic_demo.synthetic">^true$</field>
    <field name="tpic_demo.event_type">^outbound_transfer$</field>
    <description>TPIC demo (synthetic): outbound transfer from $(tpic_demo.src_host) to $(tpic_demo.dest_host)</description>
  </rule>

  <rule id="100501" level="3">
    <if_sid>100500</if_sid>
    <field name="tpic_demo.approved_destination">^true$</field>
    <field name="tpic_demo.job">backup</field>
    <description>TPIC demo (synthetic): scheduled backup from $(tpic_demo.src_host) to approved destination $(tpic_demo.dest_host) - expected, benign</description>
    <group>tpic_demo_benign,</group>
  </rule>

  <rule id="100502" level="8">
    <if_sid>100500</if_sid>
    <field name="tpic_demo.approved_destination">^false$</field>
    <description>TPIC demo (synthetic): outbound transfer from $(tpic_demo.src_host) to unapproved destination $(tpic_demo.dest_host) - simulated event</description>
    <group>tpic_demo_suspicious,</group>
  </rule>

  <!-- 1 GB or more: bytes_out has at least ten integer digits. -->
  <rule id="100503" level="12">
    <if_sid>100502</if_sid>
    <field name="tpic_demo.bytes_out" type="pcre2">^\d{10,}(\.\d+)?$</field>
    <description>TPIC demo (synthetic): large outbound transfer (1 GB or more) from $(tpic_demo.src_host) to unapproved destination $(tpic_demo.dest_host) - simulated event, not evidence of real exfiltration</description>
    <mitre>
      <id>T1048</id>
    </mitre>
    <group>tpic_demo_suspicious,</group>
  </rule>

</group>
