{
  "policy": {
    "description": "Disposable Wazuh demo: retain time-series indices for seven days",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "7d"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "delete": {}
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": [
          "wazuh-alerts-*",
          "wazuh-archives-*",
          "wazuh-monitoring-*",
          "wazuh-statistics-*"
        ],
        "priority": 100
      }
    ]
  }
}
