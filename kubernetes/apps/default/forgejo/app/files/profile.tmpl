{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content user profile">
	<div class="ui container">
		{{template "base/alert" .}}
{{if and .IsSigned (eq .SignedUserID .ContextUser.ID)}}
		{{/* ============================================================
		     OWNER VIEW - the original Forgejo profile, unchanged.
		     Andrei (signed in, viewing his own profile) keeps the full
		     repo list, tabs and management UI.
		     ============================================================ */}}
		<div class="ui stackable grid">
			<div class="ui four wide column">
				{{template "shared/user/profile_big_avatar" .}}
			</div>
			<div class="ui twelve wide column tw-mb-4">
				{{template "user/overview/header" .}}
				{{if eq .TabName "activity"}}
					{{if eq .SignedUserID .ContextUser.ID}}
					<p id="visibility-hint">
						{{if .ContextUser.KeepActivityPrivate}}
							{{ctx.Locale.Tr "user.public_activity.visibility_hint.self_private" (print AppSubUrl "/user/settings#keep-activity-private")}}
						{{else}}
							{{if eq .ContextUser.Visibility 2}}
								{{ctx.Locale.Tr "user.public_activity.visibility_hint.self_private_profile" (print AppSubUrl "/user/settings#visibility-setting")}}
							{{else}}
								{{ctx.Locale.Tr "user.public_activity.visibility_hint.self_public" (print AppSubUrl "/user/settings#keep-activity-private")}}
							{{end}}
						{{end}}
					</p>
					{{else}}
						{{if .IsAdmin}}
						<div id="visibility-hint" class="ui info message">
							{{if or .ContextUser.KeepActivityPrivate (eq .ContextUser.Visibility 2)}}
								{{ctx.Locale.Tr "user.public_activity.visibility_hint.admin_private"}}
							{{else}}
								{{ctx.Locale.Tr "user.public_activity.visibility_hint.admin_public"}}
							{{end}}
						</div>
						{{else}}
							{{if .ContextUser.KeepActivityPrivate}}
								<p id="visibility-hint">{{ctx.Locale.Tr "user.disabled_public_activity"}}</p>
							{{end}}
						{{end}}
					{{end}}
					{{if or .IsAdmin (eq .SignedUserID .ContextUser.ID) (not .ContextUser.KeepActivityPrivate)}}
						{{template "user/heatmap" .}}
						{{template "user/dashboard/feeds" .}}
					{{end}}
				{{else if eq .TabName "stars"}}
					<div class="stars">
						{{template "shared/repo_search" .}}
						{{template "explore/repo_list" .}}
						{{template "base/paginate" .}}
					</div>
				{{else if eq .TabName "following"}}
					{{template "repo/user_cards" .}}
				{{else if eq .TabName "followers"}}
					{{template "repo/user_cards" .}}
				{{else if eq .TabName "overview"}}
					<div id="readme_profile" class="{{if not .IsProfileReadmePlain}}markup{{end}}">
					{{if .IsProfileReadmePlain}}
						<pre>{{.ProfileReadme}}</pre>
					{{else}}
						{{.ProfileReadme}}
					{{end}}
					</div>
				{{else}}
					{{template "shared/repo_search" .}}
					{{template "explore/repo_list" .}}
					{{template "base/paginate" .}}
				{{end}}
			</div>
		</div>
{{else}}
		{{/* PUBLIC VIEW - business card in the andrei.iacob.co.uk house style:
		     warm paper, ink type, clay accent, one gold moment for the peak day. */}}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap">
		<style>
			/* Tokens lifted straight from andrei.iacob.co.uk globals.css so the two
			   surfaces stay in step. Paper/ink/clay are the site's; gold is the one
			   addition, reserved entirely for the peak contribution day. */
			.ap-wrap{
				--paper-hi:#fcf9f3;--paper:#f6f2e9;--paper-lo:#efe9dc;
				--ink:27 30 36;                  /* #1b1e24 - site --color-ink */
				--clay:#d5461a;                  /* hsl(14 78% 47%) - site --accent */
				--clay-soft:#b83919;             /* hsl(12 76% 41%) - site --accent-soft, 5.0:1 on paper */
				--gold:#d4a017;                  /* graphic only - 2.4:1, never carries text alone */
				--gold-ink:#856310;              /* text-safe gold, 4.8:1 on paper */
				--ease:cubic-bezier(.2,.8,.2,1); /* the site's only easing token */
				--display:"Bricolage Grotesque",system-ui,-apple-system,"Segoe UI",sans-serif;
				--sans:"DM Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
				--mono:ui-monospace,"SFMono-Regular",Menlo,Monaco,monospace;
				color-scheme:light;
				display:flex;justify-content:center;
				padding:clamp(16px,2.5vw,32px) 8px clamp(28px,5vw,56px);
			}
			.ap-wrap *{box-sizing:border-box}
			.ap-wrap ::selection{background:rgb(213 70 26 / .22);color:#11151a;text-shadow:none}

			.ap-card{
				position:relative;overflow:hidden;width:100%;min-width:0;max-width:880px;
				padding:clamp(24px,4vw,44px);border-radius:20px;
				background:radial-gradient(120% 90% at 50% -8%,var(--paper-hi) 0%,var(--paper) 42%,var(--paper-lo) 100%);
				border:1px solid rgb(var(--ink) / .10);
				box-shadow:0 1px 0 0 rgb(255 255 255 / .6) inset,0 34px 70px -34px rgb(var(--ink) / .55);
				font-family:var(--sans);color:rgb(var(--ink) / .9);
				animation:ap-rise .7s var(--ease) both;
			}
			/* One ambient wash, not per-section bands. 5% clay keeps it warm without tinting the type. */
			.ap-tint{position:absolute;right:-14%;top:-22%;width:520px;height:520px;pointer-events:none;z-index:0;
				background:radial-gradient(circle,rgb(213 70 26 / .07),transparent 62%)}
			.ap-card>:not(.ap-tint){position:relative;z-index:1}

			.ap-head{display:flex;align-items:flex-end;gap:clamp(16px,3vw,28px)}
			.ap-avatar{flex:none}
			.ap-avatar img{width:clamp(84px,12vw,116px)!important;height:clamp(84px,12vw,116px)!important;
				border-radius:14px;object-fit:cover;display:block;
				box-shadow:0 0 0 1px rgb(var(--ink) / .12),0 14px 30px -16px rgb(var(--ink) / .6)}
			.ap-id{min-width:0}
			.ap-eyebrow{margin:0 0 10px;font-family:var(--sans);font-size:11px;font-weight:600;
				text-transform:uppercase;letter-spacing:.22em;color:rgb(var(--ink) / .65)}
			.ap-name{margin:0;font-family:var(--display);font-size:clamp(34px,5.4vw,58px);font-weight:700;
				line-height:.95;letter-spacing:-.03em;color:rgb(var(--ink));text-wrap:balance}
			.ap-tagline{margin:14px 0 0;font-size:16.5px;line-height:1.5;color:rgb(var(--ink) / .7);max-width:58ch;text-wrap:balance}
			.ap-meta{margin:14px 0 0;font-family:var(--mono);font-size:12.5px;color:rgb(var(--ink) / .65)}
			.ap-link{color:inherit;text-decoration:none;border-bottom:1px solid rgb(var(--ink) / .22);padding-bottom:1px;
				transition:border-color .2s var(--ease),color .2s var(--ease)}
			.ap-link:hover{color:var(--clay-soft);border-bottom-color:var(--clay-soft)}
			.ap-wrap a:focus-visible{outline:none;border-radius:2px;
				box-shadow:0 0 0 2px var(--paper),0 0 0 4px rgb(213 70 26 / .75)}
			/* The site's uptime heartbeat, same geometry. */
			.ap-dot{position:relative;display:inline-block;width:7px;height:7px;border-radius:50%;
				background:var(--clay-soft);box-shadow:0 0 6px rgb(184 57 25 / .8);margin-right:9px;vertical-align:middle}
			.ap-dot::after{content:"";position:absolute;inset:-3px;border-radius:50%;
				border:1px solid rgb(184 57 25 / .6);animation:ap-ping 2.6s var(--ease) infinite}

			/* Hairline rules, no boxed tiles - the site's <dl> stat treatment. */
			.ap-stats{margin:clamp(26px,4vw,38px) 0 0;display:grid;grid-template-columns:repeat(5,1fr);gap:clamp(12px,2vw,20px)}
			.ap-stats dt,.ap-stats dd{margin:0}
			.ap-stat{border-top:1px solid rgb(var(--ink) / .15);padding-top:14px}
			.ap-stat-num{font-family:var(--display);font-size:clamp(26px,3.4vw,36px);font-weight:700;
				line-height:1;letter-spacing:-.02em;color:rgb(var(--ink));font-variant-numeric:tabular-nums;
				display:flex;align-items:center;gap:8px}
			.ap-stat-lab{margin-top:10px;font-size:13.5px;line-height:1.35;color:rgb(var(--ink) / .65)}
			.ap-when{display:block;margin-top:3px;font-family:var(--mono);font-size:12px;color:rgb(var(--ink) / .5)}
			.ap-stat.peak{border-top-color:var(--gold)}
			.ap-stat.peak .ap-stat-num{color:var(--gold-ink)}

			.ap-graph{margin-top:clamp(26px,4vw,36px)}
			.ap-heatmap{display:flex;flex-direction:column;gap:10px;min-width:0;--cell:11px;--gap:3px}
			/* The Mon/Wed/Fri gutter sits OUTSIDE the scroller. Sticky-inside-the-scroller
			   needed an opaque patch, and no flat colour matches the card's paper gradient. */
			.ap-hm-wrap{display:flex;gap:var(--gap);min-width:0}
			.ap-hm-gutter{flex:none;display:flex;flex-direction:column;gap:5px;padding-top:2px}
			.ap-hm-spacer{height:13px}
			.ap-hm-scroll{flex:1;min-width:0;overflow-x:auto;overflow-y:hidden;padding:2px 0 6px;
				scrollbar-width:thin;scrollbar-color:rgb(var(--ink) / .2) transparent}
			.ap-hm-scroll::-webkit-scrollbar{height:7px}
			.ap-hm-scroll::-webkit-scrollbar-thumb{background:rgb(var(--ink) / .18);border-radius:4px}
			/* 11px cell + 3px gap: 53 weeks plus the 28px day gutter lands at 770px,
			   inside the 800px content width, so the card never scrolls on desktop. */
			.ap-hm-inner{display:inline-flex;flex-direction:column;gap:5px}
			.ap-hm-months{display:grid;grid-auto-rows:13px;column-gap:var(--gap);
				font-family:var(--mono);font-size:10.5px;color:rgb(var(--ink) / .5)}
			.ap-hm-months span{grid-row:1;white-space:nowrap;overflow:visible}
			.ap-hm-days{display:grid;grid-template-rows:repeat(7,var(--cell));row-gap:var(--gap);width:28px;
				font-family:var(--mono);font-size:10px;color:rgb(var(--ink) / .5)}
			.ap-hm-days span{line-height:var(--cell);height:var(--cell)}
			.ap-hm-grid{display:grid;grid-template-rows:repeat(7,var(--cell));grid-auto-columns:var(--cell);
				grid-auto-flow:column;gap:var(--gap)}
			/* Ink-alpha ramp, identical stops to the graph on andrei.iacob.co.uk. */
			.ap-cell{width:var(--cell);height:var(--cell);border-radius:3px;background:rgb(var(--ink) / .06);
				transition:transform .12s var(--ease)}
			.ap-cell[data-level="1"]{background:rgb(var(--ink) / .2)}
			.ap-cell[data-level="2"]{background:rgb(var(--ink) / .4)}
			.ap-cell[data-level="3"]{background:rgb(var(--ink) / .6)}
			.ap-cell[data-level="4"]{background:rgb(var(--ink) / .85)}
			.ap-cell[data-future="1"]{background:transparent}
			/* The one gold moment. Ink ring so the peak reads without relying on hue. */
			.ap-cell[data-peak="1"]{background:var(--gold);
				box-shadow:0 0 0 1px rgb(var(--ink) / .45),0 0 0 3.5px rgb(212 160 23 / .28)}
			.ap-cell:hover{transform:scale(1.4)}
			.ap-hm-foot{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;
				font-family:var(--mono);font-size:11.5px;color:rgb(var(--ink) / .55)}
			.ap-hm-keys{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
			.ap-hm-legend{display:flex;align-items:center;gap:5px}
			.ap-hm-legend i{width:11px;height:11px;border-radius:3px;display:inline-block;background:rgb(var(--ink) / .06)}
			.ap-hm-legend i[data-level="1"]{background:rgb(var(--ink) / .2)}
			.ap-hm-legend i[data-level="2"]{background:rgb(var(--ink) / .4)}
			.ap-hm-legend i[data-level="3"]{background:rgb(var(--ink) / .6)}
			.ap-hm-legend i[data-level="4"]{background:rgb(var(--ink) / .85)}
			.ap-hm-legend i[data-peak="1"]{background:var(--gold);box-shadow:0 0 0 1px rgb(var(--ink) / .45)}
			.ap-hm-skeleton{height:112px;border-radius:6px;
				background:linear-gradient(90deg,rgb(var(--ink) / .05),rgb(var(--ink) / .1),rgb(var(--ink) / .05));
				background-size:200% 100%;animation:ap-shimmer 1.3s ease-in-out infinite}
			.ap-hm-note{font-family:var(--mono);font-size:12.5px;color:rgb(var(--ink) / .5);padding:10px 0}

			.ap-tech{margin-top:clamp(26px,4vw,36px);padding-top:clamp(20px,3vw,26px);
				border-top:1px solid rgb(var(--ink) / .12);display:flex;flex-direction:column;gap:16px}
			.ap-tech-row{display:flex;gap:18px;align-items:flex-start}
			.ap-tech-label{flex:0 0 84px;font-size:11px;font-weight:600;text-transform:uppercase;
				letter-spacing:.22em;color:rgb(var(--ink) / .65);line-height:26px}
			.ap-chips{display:flex;flex-wrap:wrap;gap:7px}
			/* Text chips, not shields.io colour blocks - hue here would carry no meaning. */
			.ap-chip{display:inline-flex;align-items:center;height:26px;padding:0 12px;border-radius:999px;
				border:1px solid rgb(var(--ink) / .16);font-size:12.5px;color:rgb(var(--ink) / .78);
				white-space:nowrap;transition:border-color .2s var(--ease),color .2s var(--ease)}
			.ap-chip:hover{border-color:rgb(184 57 25 / .5);color:var(--clay-soft)}

			@keyframes ap-rise{from{opacity:.01;transform:translateY(14px)}to{opacity:1;transform:none}}
			@keyframes ap-shimmer{from{background-position:200% 0}to{background-position:-200% 0}}
			@keyframes ap-ping{0%{transform:scale(.7);opacity:.9}70%,100%{transform:scale(2.4);opacity:0}}
			@media (max-width:760px){.ap-stats{grid-template-columns:repeat(3,1fr)}}
			@media (max-width:560px){.ap-stats{grid-template-columns:repeat(2,1fr)}
				.ap-head{flex-direction:column;align-items:flex-start;gap:18px}
				.ap-tech-row{flex-direction:column;gap:8px}.ap-tech-label{flex:none;line-height:1.6}}
			@media (hover:none){.ap-cell:hover{transform:none}}
			@media (prefers-reduced-motion:reduce){
				.ap-card{animation:none}.ap-cell,.ap-chip,.ap-link{transition:none}
				.ap-hm-skeleton{animation:none}.ap-dot::after{animation:none}}
		</style>

		<section class="ap-wrap">
			<article class="ap-card" aria-label="Andrei Iacob">
				<div class="ap-tint" aria-hidden="true"></div>
				<header class="ap-head">
					<div class="ap-avatar">{{ctx.AvatarUtils.Avatar .ContextUser 256}}</div>
					<div class="ap-id">
						<p class="ap-eyebrow">CS Student - Full-Stack &amp; Self-Hosted Infra</p>
						<h1 class="ap-name">Andrei Iacob</h1>
						<p class="ap-tagline">I build for the web and self-host everything else - a 30+ service Kubernetes homelab on Proxmox, run entirely through GitOps.</p>
						<p class="ap-meta"><span class="ap-dot" aria-hidden="true"></span>Everything else lives at <a class="ap-link" href="https://andrei.iacob.co.uk" target="_blank" rel="noopener noreferrer">andrei.iacob.co.uk</a></p>
					</div>
				</header>

				<dl class="ap-stats">
					<div class="ap-stat">
						<dt class="ap-stat-num" data-stat="total">0</dt>
						<dd class="ap-stat-lab">Contributions</dd>
					</div>
					<div class="ap-stat">
						<dt class="ap-stat-num" data-stat="current">0</dt>
						<dd class="ap-stat-lab">Current streak</dd>
					</div>
					<div class="ap-stat">
						<dt class="ap-stat-num" data-stat="longest">0</dt>
						<dd class="ap-stat-lab">Longest streak</dd>
					</div>
					<div class="ap-stat">
						<dt class="ap-stat-num" data-stat="active">0</dt>
						<dd class="ap-stat-lab">Active days</dd>
					</div>
					<div class="ap-stat peak">
						<dt class="ap-stat-num" data-stat="peak">0</dt>
						<dd class="ap-stat-lab">Peak day<span class="ap-when" data-stat-when="peak"></span></dd>
					</div>
				</dl>

				<div class="ap-graph">
					<div id="ap-heatmap" class="ap-heatmap" data-src="{{AppSubUrl}}/assets/data/heatmap.json" role="img" aria-label="Contribution activity over the last year">
						<div class="ap-hm-skeleton"></div>
					</div>
				</div>

				<section class="ap-tech" aria-label="Tech stack">
					<div class="ap-tech-row">
						<span class="ap-tech-label">Languages</span>
						<div class="ap-chips"><span class="ap-chip">TypeScript</span><span class="ap-chip">Python</span><span class="ap-chip">JavaScript</span><span class="ap-chip">Java</span><span class="ap-chip">C#</span><span class="ap-chip">C++</span><span class="ap-chip">Swift</span><span class="ap-chip">Shell</span></div>
					</div>
					<div class="ap-tech-row">
						<span class="ap-tech-label">Infra</span>
						<div class="ap-chips"><span class="ap-chip">Kubernetes</span><span class="ap-chip">Proxmox</span><span class="ap-chip">Flux CD</span><span class="ap-chip">Talos Linux</span><span class="ap-chip">Docker</span><span class="ap-chip">Cilium</span><span class="ap-chip">WireGuard</span><span class="ap-chip">Cloudflare</span></div>
					</div>
					<div class="ap-tech-row">
						<span class="ap-tech-label">Stack</span>
						<div class="ap-chips"><span class="ap-chip">React</span><span class="ap-chip">Next.js</span><span class="ap-chip">Node.js</span><span class="ap-chip">.NET</span><span class="ap-chip">PostgreSQL</span><span class="ap-chip">Redis</span><span class="ap-chip">Grafana</span><span class="ap-chip">Tailwind</span></div>
					</div>
				</section>
			</article>
		</section>

		<script>
		(function(){
			var root=document.getElementById('ap-heatmap');
			if(!root)return;
			var src=root.getAttribute('data-src');
			var REDUCED=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
			function lvl(c){if(c<=0)return 0;if(c<3)return 1;if(c<7)return 2;if(c<15)return 3;return 4;}
			function key(d){return d.toISOString().slice(0,10);}
			var MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
			function note(msg){root.innerHTML='<div class="ap-hm-note">'+msg+'</div>';}
			fetch(src+'?t='+Math.floor(Date.now()/3600000),{cache:'no-cache'})
				.then(function(r){if(!r.ok)throw 0;return r.json();})
				.then(function(data){
					var days=(data.days||[]);
					if(!days.length){note('No activity recorded yet.');return;}
					var peak=peakOf(days);
					render(data,peak);
					stats(data,peak);
				})
				.catch(function(){note('Activity graph unavailable.');});

			function countUp(el,val){
				if(REDUCED){el.textContent=val.toLocaleString();return;}
				var start=null;
				function step(ts){if(start===null)start=ts;var p=Math.min((ts-start)/950,1),e=1-Math.pow(1-p,3);el.textContent=Math.round(e*val).toLocaleString();if(p<1)requestAnimationFrame(step);}
				requestAnimationFrame(step);
			}
			function setStat(name,val){var el=document.querySelector('[data-stat="'+name+'"]');if(!el)return;var out=el.querySelector('span')||el;countUp(out,val);}

			/* Busiest single day in the window. Ties resolve to the most recent date,
			   so the gold cell is the latest best day rather than the oldest. */
			function peakOf(days){
				var today=key(new Date(Date.now()));
				var best={count:0,date:null};
				days.forEach(function(d){
					if(!d||!d.date||d.date>today)return;
					var c=d.count||0;
					if(c>best.count||(c===best.count&&c>0&&d.date>best.date))best={count:c,date:d.date};
				});
				return best;
			}
			function pretty(ds){
				var d=new Date(ds+'T00:00:00Z');
				return d.getUTCDate()+' '+MON[d.getUTCMonth()];
			}

			function stats(data,peak){
				var arr=(data.days||[]).filter(function(d){return d.count>0;}).map(function(d){return d.date;});
				var set={};arr.forEach(function(d){set[d]=1;});
				var active=arr.length,total=data.total||0;
				var sorted=arr.slice().sort();
				var longest=0,run=0,prev=null;
				sorted.forEach(function(ds){var d=Date.parse(ds+'T00:00:00Z');if(prev!==null&&(d-prev)===86400000){run++;}else{run=1;}if(run>longest)longest=run;prev=d;});
				var cur=0,t=new Date();t.setUTCHours(0,0,0,0);
				if(!set[key(t)])t.setUTCDate(t.getUTCDate()-1);
				while(set[key(t)]){cur++;t.setUTCDate(t.getUTCDate()-1);}
				setStat('total',total);setStat('current',cur);setStat('longest',longest);setStat('active',active);
				setStat('peak',peak.count);
				var when=document.querySelector('[data-stat-when="peak"]');
				if(when)when.textContent=peak.date?pretty(peak.date):'';
			}

			function render(data,peak){
				var counts={};(data.days||[]).forEach(function(d){counts[d.date]=d.count;});
				var today=new Date();today.setUTCHours(0,0,0,0);
				var end=new Date(today);end.setUTCDate(end.getUTCDate()+(6-end.getUTCDay()));
				var WEEKS=53;
				var start=new Date(end);start.setUTCDate(start.getUTCDate()-(WEEKS*7-1));
				var inner=document.createElement('div');inner.className='ap-hm-inner';
				var months=document.createElement('div');months.className='ap-hm-months';
				months.style.gridTemplateColumns='repeat('+WEEKS+',var(--cell))';
				var days=document.createElement('div');days.className='ap-hm-days';
				['','Mon','','Wed','','Fri',''].forEach(function(t){var s=document.createElement('span');s.textContent=t;days.appendChild(s);});
				var grid=document.createElement('div');grid.className='ap-hm-grid';
				var cur=new Date(start),lastMonth=-1,peakSeen=false;
				for(var i=0;i<WEEKS*7;i++){
					if(cur.getUTCDay()===0){var col=Math.floor(i/7);var m=cur.getUTCMonth();if(m!==lastMonth){var sp=document.createElement('span');sp.textContent=MON[m];sp.style.gridColumnStart=(col+1);months.appendChild(sp);lastMonth=m;}}
					var cell=document.createElement('div');cell.className='ap-cell';var k=key(cur);
					if(cur>today){cell.setAttribute('data-future','1');}else{
						var c=counts[k]||0;
						cell.setAttribute('data-level',lvl(c));
						cell.title=(c===0?'No contributions':(c+' contribution'+(c>1?'s':'')))+' on '+k;
						if(peak.date&&k===peak.date){cell.setAttribute('data-peak','1');cell.title='Peak day - '+cell.title;peakSeen=true;}
					}
					grid.appendChild(cell);cur.setUTCDate(cur.getUTCDate()+1);
				}
				var foot=document.createElement('div');foot.className='ap-hm-foot';
				var cap=document.createElement('span');cap.textContent='GitHub + Forgejo, last 12 months';
				var keys=document.createElement('span');keys.className='ap-hm-keys';
				if(peakSeen){
					var pk=document.createElement('span');pk.className='ap-hm-legend';
					var gi=document.createElement('i');gi.setAttribute('data-peak','1');
					pk.appendChild(gi);pk.appendChild(document.createTextNode('Peak day'));
					keys.appendChild(pk);
				}
				var leg=document.createElement('span');leg.className='ap-hm-legend';
				leg.appendChild(document.createTextNode('Less'));
				[0,1,2,3,4].forEach(function(L){var i=document.createElement('i');if(L)i.setAttribute('data-level',L);leg.appendChild(i);});
				leg.appendChild(document.createTextNode('More'));
				keys.appendChild(leg);
				foot.appendChild(cap);foot.appendChild(keys);
				inner.appendChild(months);inner.appendChild(grid);
				var scroll=document.createElement('div');scroll.className='ap-hm-scroll';scroll.appendChild(inner);
				var gutter=document.createElement('div');gutter.className='ap-hm-gutter';
				var spacer=document.createElement('div');spacer.className='ap-hm-spacer';
				gutter.appendChild(spacer);gutter.appendChild(days);
				var wrap=document.createElement('div');wrap.className='ap-hm-wrap';
				wrap.appendChild(gutter);wrap.appendChild(scroll);
				root.innerHTML='';root.appendChild(wrap);root.appendChild(foot);
				scroll.scrollLeft=scroll.scrollWidth;
			}
		})();
		</script>
{{end}}
	</div>
</div>

{{if and .IsSigned (eq .SignedUserID .ContextUser.ID)}}
<div class="ui g-modal-confirm delete modal" id="block-user">
	<div class="header">
		{{ctx.Locale.Tr "user.block_user"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "user.block_user.detail"}}</p>
		<ul>
			<li>{{ctx.Locale.Tr "user.block_user.detail_1"}}</li>
			<li>{{ctx.Locale.Tr "user.block_user.detail_2"}}</li>
			<li>{{ctx.Locale.Tr "user.block_user.detail_3"}}</li>
		</ul>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
{{end}}

{{template "base/footer" .}}
