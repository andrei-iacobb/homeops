{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    // Version holds written by Hermes alert triage when a Renovate merge breaks a
    // workload: revert + hold so the same release is not re-merged next run.
    "local>andrei/homeops//.renovate/hermes-holds.json5",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
    ":separatePatchReleases",
  ],
  timezone: "Europe/London",
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  // Self-hosted Renovate on Forgejo merges its own PRs natively.
  platformAutomerge: true,
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  ignorePaths: ["**/*.sops.*"],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  helmfile: {
    managerFilePatterns: [
      "/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
      "/(^|/)helmfile\\.d/.+\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
    ],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  kustomize: {
    managerFilePatterns: ["/^kustomization\\.ya?ml(?:\\.j2)?$/"],
  },
  packageRules: [
    // =====================
    // Automerge Rules
    // =====================
    {
      description: ["Auto-merge all container updates, majors included (holds below carve out the exceptions)"],
      matchDatasources: ["docker"],
      matchUpdateTypes: ["major", "minor", "patch", "digest"],
      automerge: true,
      ignoreTests: true,
    },
    {
      description: ["Auto-merge all Helm chart updates, majors included"],
      matchDatasources: ["helm"],
      matchUpdateTypes: ["major", "minor", "patch"],
      automerge: true,
      ignoreTests: true,
    },
    {
      description: ["Auto-merge all GitHub release updates, majors included"],
      matchDatasources: ["github-releases", "github-tags"],
      matchUpdateTypes: ["major", "minor", "patch"],
      automerge: true,
      ignoreTests: true,
    },
    {
      description: ["Auto-merge GitHub Actions minor and patch"],
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      ignoreTests: true,
    },
    {
      description: ["Auto-merge Mise Tools"],
      matchManagers: ["mise"],
      automerge: true,
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    // =====================
    // Holds - the only things that still wait for a human
    // =====================
    {
      description: ["Talos and Kubernetes node components are applied with talosctl, not Flux: never automerge"],
      matchPackageNames: ["/siderolabs/", "/talos/"],
      automerge: false,
    },
    {
      description: [
        "Majors only: databases (on-disk format changes), CNI/gateway/cert-manager (lock-out risk) and the app-template chart (every HelmRelease at once). Minors, patches and digests automerge.",
      ],
      matchUpdateTypes: ["major"],
      matchPackageNames: [
        "/clickhouse/",
        "/postgres/",
        "/postgresql/",
        "/cloudnative-pg/",
        "/redis/",
        "/mariadb/",
        "/mongo/",
        "/minio/",
        "/envoy/",
        "/cilium/",
        "/cert-manager/",
        "/bjw-s-labs/helm/app-template/",
      ],
      automerge: false,
    },
    // =====================
    // Media stack - out of hours only
    // =====================
    {
      description: [
        "Media namespace (kubernetes/apps/media): open and merge PRs only between 01:00 and 05:00 Europe/London so Plex and the arr stack roll while nobody is watching. platformAutomerge is off here so Renovate itself merges inside the window.",
      ],
      matchFileNames: ["kubernetes/apps/media/**"],
      schedule: ["after 1am and before 5am"],
      automergeSchedule: ["after 1am and before 5am"],
      automerge: true,
      platformAutomerge: false,
      ignoreTests: true,
    },
    {
      description: [
        "Core services: same 01:00-05:00 Europe/London window as media. Networking, certs, Flux, storage, databases, monitoring and the apps that hold auth, passwords, git, photos and documents. Everything else updates whenever Renovate runs.",
      ],
      matchFileNames: [
        "kubernetes/apps/network/**",
        "kubernetes/apps/cert-manager/**",
        "kubernetes/apps/flux-system/**",
        "kubernetes/apps/kube-system/**",
        "kubernetes/apps/storage/**",
        "kubernetes/apps/databases/**",
        "kubernetes/apps/monitoring/**",
        "kubernetes/apps/code/**",
        "kubernetes/apps/default/authentik/**",
        "kubernetes/apps/default/vaultwarden/**",
        "kubernetes/apps/default/forgejo/**",
        "kubernetes/apps/default/forgejo-runner/**",
        "kubernetes/apps/default/immich/**",
        "kubernetes/apps/default/paperless/**",
        "kubernetes/apps/default/n8n/**",
        "kubernetes/apps/default/unifi/**",
        "kubernetes/apps/default/homepage/**",
        "kubernetes/apps/default/solis-charge/**",
        "kubernetes/flux/**",
        "kubernetes/components/**",
      ],
      // No automerge key here: whether it merges is still decided by the
      // datasource rules and the major-version holds above, this only sets when.
      schedule: ["after 1am and before 5am"],
      automergeSchedule: ["after 1am and before 5am"],
      platformAutomerge: false,
    },
    {
      description: ["searxng publishes calendar tags like 2026.10.4-d48c4b555: tell Renovate how to order them"],
      matchDatasources: ["docker"],
      matchPackageNames: ["searxng/searxng", "docker.io/searxng/searxng"],
      versioning: "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,3})-(?<build>[a-f0-9]+)$",
    },
    // =====================
    // Floating tags - pin the digest so Renovate can still roll them
    // =====================
    {
      description: ["Anything left on latest/main/stable gets a digest pin; digest bumps then flow through the automerge rules"],
      matchDatasources: ["docker"],
      matchCurrentValue: "/^(latest|main|stable)$/",
      pinDigests: true,
    },
    {
      description: [
        "linuxserver overseerr/calibre-web: ignore legacy date-style tags (2021.x) that sort above the real semver tags",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["lscr.io/linuxserver/overseerr", "lscr.io/linuxserver/calibre-web"],
      allowedVersions: "<2000",
    },
    {
      description: [
        "Ignore lakker/pulsarr >=1.0 — GitHub releases use 1.x semver but Docker Hub only publishes 0.x tags",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/lakker/pulsarr", "lakker/pulsarr"],
      matchCurrentVersion: "!/^0\\./",
      enabled: false,
    },
    {
      description: [
        "Hold docker dind at 27 (andrei-iacobb/homeops#687). The Talos node reboot on 2026-09-18 23:21 BST is the only one with instrumented evidence: a talosctl dmesg capture ends 21s earlier on docker0 veth churn from the forgejo-runner dind sidecar, which had just been bumped to 29-dind. Not proven, so this is a precaution. Retest on a throwaway node before raising it.",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["docker", "docker.io/library/docker"],
      allowedVersions: "<28",
    },
    // =====================
    // Grouping
    // =====================
    {
      description: ["Flux Operator Group"],
      groupName: "Flux Operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    // =====================
    // Commit Messages
    // =====================
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(container)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "container",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "container",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      semanticCommitType: "chore",
      semanticCommitScope: "container",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentDigestShort}} → {{newDigestShort}} )",
    },
    {
      matchDatasources: ["helm"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(helm)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["helm"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "helm",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["helm"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "helm",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(github-release)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "github-release",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "github-release",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(github-action)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "github-action",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "github-action",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    // =====================
    // Labels
    // =====================
    {
      matchUpdateTypes: ["major"],
      labels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      labels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      labels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      labels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      addLabels: ["renovate/github-release"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
  ],
  customManagers: [
    {
      description: ["Process annotated dependencies"],
      customType: "regex",
      managerFilePatterns: [
        "/(^|/).+\\.env(?:\\.j2)?$/",
        "/(^|/).+\\.sh(?:\\.j2)?$/",
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/",
      ],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      customType: "regex",
      description: ["Process OCI dependencies"],
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: ["oci://(?<depName>[^:]+):(?<currentValue>\\S+)"],
      datasourceTemplate: "docker",
    },
  ],
}
